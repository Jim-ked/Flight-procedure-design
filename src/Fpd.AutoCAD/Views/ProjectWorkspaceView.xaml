<UserControl x:Class="Fpd.AutoCAD.Views.ProjectWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#252525" Foreground="#EDEDED"
             FontFamily="Microsoft YaHei UI" FontSize="13">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <SolidColorBrush x:Key="Surface" Color="#252525"/>
    <SolidColorBrush x:Key="Field" Color="#323232"/>
    <SolidColorBrush x:Key="Outline" Color="#555555"/>
    <SolidColorBrush x:Key="Text" Color="#ECECEC"/>
    <SolidColorBrush x:Key="Muted" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="Selection" Color="#34536A"/>
    <Style x:Key="ProjectActionButton" TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Margin" Value="3,0,3,0"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Background" Value="#393939"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ProjectInput" TargetType="TextBox">
      <Setter Property="Height" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="7,0"/>
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
    </Style>
    <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="4,7"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="BorderBrush" Value="#6CA8C2"/>
          <Setter Property="Background" Value="#393939"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <!-- 根容器提供确定的可用高度，禁止外层 ScrollViewer。 -->
  <Grid Margin="10,8,10,8">
    <!-- 未建立项目：仅显示创建信息，不显示禁用工具栏。 -->
    <Border x:Name="SetupPanel" MaxWidth="390" Padding="14"
            HorizontalAlignment="Stretch" VerticalAlignment="Center"
            Background="{StaticResource Surface}" BorderBrush="{StaticResource Outline}" BorderThickness="1">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Visible"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsInitialized}" Value="True">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="项目设置" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" Text="项目名称" Margin="0,0,0,3"/>
        <TextBox Grid.Row="2" Style="{StaticResource ProjectInput}" Text="{Binding DraftProjectName,UpdateSourceTrigger=PropertyChanged}"/>
        <Grid Grid.Row="3" Margin="0,10,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="机场名称" Margin="0,0,0,3"/>
          <TextBox Grid.Row="1" Style="{StaticResource ProjectInput}" Text="{Binding DraftAirportName,UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Column="0" Text="ARP 纬度" Margin="0,0,0,3"/>
          <TextBlock Grid.Column="2" Text="ARP 经度" Margin="0,0,0,3"/>
          <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource ProjectInput}" Text="{Binding DraftArpLatitude,UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource ProjectInput}" Text="{Binding DraftArpLongitude,UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <Button Grid.Row="5" Content="确定" Command="{Binding CreateProjectCommand}"
                Style="{StaticResource ProjectActionButton}" HorizontalAlignment="Right"
                MinWidth="86" Margin="0,14,0,0"/>
      </Grid>
    </Border>

    <!-- 已建立项目：顶部固定，表格一行占据全部剩余高度。 -->
    <Grid x:Name="ProjectReadyPanel" Visibility="{Binding IsInitialized,Converter={StaticResource BoolToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="5"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding ProjectName}" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{Binding ProjectName}"/>
        <Button Grid.Row="0" Grid.Column="1" Content="编辑" Command="{Binding EditProjectCommand}"
                MinWidth="76" Style="{StaticResource ProjectActionButton}" Margin="6,0,0,0"/>
        <TextBlock Grid.Row="1" Text="{Binding AirportName}" VerticalAlignment="Center" Margin="0,7,0,0"
                   TextWrapping="Wrap" ToolTip="{Binding AirportName}"/>
        <Button Grid.Row="1" Grid.Column="1" Content="坐标转换" Command="{Binding OpenCoordinateConverterCommand}"
                MinWidth="96" Style="{StaticResource ProjectActionButton}" Margin="6,5,0,0"/>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ArpDisplay}"
                   TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
      </Grid>

      <!-- 分类导航用原生 ListBox；四项等宽，不承载数据表。 -->
      <ListBox Grid.Row="2" Height="39" ItemsSource="{Binding Categories}"
               SelectedItem="{Binding SelectedCategory,Mode=TwoWay}" SelectionMode="Single"
               ItemContainerStyle="{StaticResource CategoryItemStyle}"
               BorderThickness="0" Background="Transparent" Padding="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" HorizontalAlignment="Center"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="查找" VerticalAlignment="Center" Margin="0,0,9,0"/>
        <TextBox Grid.Column="1" Style="{StaticResource ProjectInput}" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}"/>
      </Grid>

      <!-- 固定为两行，避免五个按钮在窄面板中挤压。 -->
      <Grid Grid.Row="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="新增" Command="{Binding AddCommand}" Style="{StaticResource ProjectActionButton}"/>
        <Button Grid.Column="1" Content="修改" Command="{Binding EditCommand}" Style="{StaticResource ProjectActionButton}"/>
        <Button Grid.Column="2" Content="删除" Command="{Binding DeleteCommand}" Style="{StaticResource ProjectActionButton}"/>
      </Grid>
      <Grid Grid.Row="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="导入" Command="{Binding ImportCommand}" Style="{StaticResource ProjectActionButton}"/>
        <Button Grid.Column="1" Content="导出" Command="{Binding ExportCommand}" Style="{StaticResource ProjectActionButton}"/>
      </Grid>

      <DataGrid x:Name="ProjectDataGrid" Grid.Row="10" MinHeight="0"
                ItemsSource="{Binding VisibleRows}"
                AutoGenerateColumns="False" IsReadOnly="True"
                CanUserAddRows="False" CanUserDeleteRows="False"
                CanUserSortColumns="False" CanUserResizeColumns="True"
                SelectionMode="Extended" SelectionUnit="FullRow"
                EnableRowVirtualization="True" EnableColumnVirtualization="False"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="30" ColumnHeaderHeight="32"
                Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
                BorderBrush="{StaticResource Outline}" BorderThickness="1"
                HorizontalGridLinesBrush="{StaticResource Outline}" GridLinesVisibility="Horizontal"
                RowBackground="{StaticResource Surface}" AlternatingRowBackground="#292929"
                SelectionChanged="ProjectDataGrid_SelectionChanged"
                MouseDoubleClick="ProjectDataGrid_MouseDoubleClick"
                PreviewKeyDown="ProjectDataGrid_PreviewKeyDown">
        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#353535"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
          </Style>
        </DataGrid.ColumnHeaderStyle>
      </DataGrid>
      <TextBlock Grid.Row="11" Text="{Binding CountDisplay}" Foreground="{StaticResource Muted}"
                 Margin="0,7,0,0" FontSize="12"/>
    </Grid>
  </Grid>
</UserControl>