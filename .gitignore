# Visual Studio / IDE state
.vs/
.idea/
*.user
*.suo
*.userprefs

# Build and test output
bin/
obj/
TestResults/
artifacts/
tmp/

# AutoCAD/editor lock and scratch files
*.dwl
*.dwl2
*.bak
*.sv$
*.ac$
*.cache

# Local credentials and machine-only secrets
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.jks
*.snk

# Keep recovered evidence, historical logs, fixtures, sample DWG/CSV, and
# project-local research DLLs under version control unless a file matches one
# of the explicit machine-only patterns above.

# Tool/runtime caches
__pycache__/
*.pyc
*.pyo
*.ffs_db

# Optional local build overrides and CLI state
*.local.props
.dotnet/
.nuget/


# Native AutoCAD process diagnostics stay in local investigation artifacts.
/acad.err
